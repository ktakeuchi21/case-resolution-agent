# Explicit context allowlist prevents secret files, local data and historical artifacts entering build context.
**
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!Dockerfile
!.dockerignore
!src/
!src/**
!scripts/
!scripts/build.ts
!scripts/db/
!scripts/db/cli.ts
!fixtures/
!fixtures/**
!migrations/
!migrations/*.sql
!web/
!web/**
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
**/node_modules/
**/.local/
**/.git/
