# Optional live synthetic embedding benchmark. Never commit a real key.
# Export in your shell; Node does not load this file automatically.
OPENAI_API_KEY=
# Application provider factory accepts lexical | semantic | hybrid.
# The benchmark always uses its frozen experiment JSON, not environment tuning.

# Optional database overrides. Empty uses the project-private Unix socket,
# pathway database, and separate pathway_app/pathway_owner roles.
# Do not use the migration/owner identity in application requests.
PATHWAY_DATABASE_URL=
PATHWAY_ADMIN_DATABASE_URL=
# Hosted deployment selects this explicitly; local default remains local-pg18-vector086.
# PATHWAY_DATABASE_PROFILE=supabase-pg17-vector082
# PATHWAY_DATABASE_CA_FILE=/absolute/path/to/config/supabase-ca.crt
# Homebrew native executable directory; no service registration required.
PATHWAY_PG_BIN=/opt/homebrew/opt/postgresql@18/bin

# Production same-origin server. Use the exact HTTPS Render origin; no trailing slash.
NODE_ENV=development
PUBLIC_ORIGIN=
HOST=127.0.0.1
PORT=3000
# No public endpoint enables OpenAI calls; packaged synthetic vectors only.
