(version 1)
(allow default)
(deny file-read-data (literal "/Users/kaitakeuchi/.claude.json"))
(deny file-read-data (subpath "/Users/kaitakeuchi/.claude"))
(deny file-read-data (subpath "/Users/kaitakeuchi/.gbrain"))
(deny file-read-data (subpath "/Users/kaitakeuchi/.aws"))
(deny file-read-data (subpath "/Users/kaitakeuchi/.ssh"))
(deny file-read-data (literal "/Users/kaitakeuchi/.codex/auth.json"))
(deny file-write* (subpath "/Users/kaitakeuchi/.claude"))
(deny file-write* (literal "/Users/kaitakeuchi/.claude.json"))
(deny file-write* (literal "/Users/kaitakeuchi/.codex/config.toml"))
(deny file-write* (subpath "/Users/kaitakeuchi/Documents/pathway-agent"))

(deny network*)
