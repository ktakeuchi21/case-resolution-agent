{
  "name": "pathway-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Synthetic portfolio demonstration of persistent governed patient-access workflows",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "eval": "node src/cli.ts eval",
    "demo": "node src/cli.ts demo",
    "probes": "node src/cli.ts probes",
    "fixtures:build": "node scripts/build-fixtures.ts",
    "check": "npm run typecheck && npm test && npm run eval && npm run demo",
    "benchmark": "node src/benchmark-cli.ts",
    "trace:contracts": "node scripts/trace-retrieval-contracts.ts",
    "db:start": "node scripts/db/local.ts start",
    "db:stop": "node scripts/db/local.ts stop",
    "db:health": "node scripts/db/local.ts status",
    "db:migrate": "node scripts/db/cli.ts migrate",
    "db:status": "node scripts/db/cli.ts status",
    "db:seed": "node scripts/db/cli.ts seed",
    "test:postgres": "node --test --test-concurrency=1 tests/postgres/*.test.ts",
    "eval:postgres": "node scripts/db/parity.ts",
    "demo:postgres": "node scripts/db/demo.ts",
    "audit:postgres": "node scripts/db/audit.ts",
    "verify:restart": "node scripts/db/after-restart.ts",
    "test:workflow": "node --test --test-concurrency=1 tests/workflow/*.test.ts",
    "workflow:demo": "node scripts/workflow/run.ts",
    "audit:workflow": "node scripts/workflow/audit.ts",
    "workflow:tick": "node scripts/workflow/tick.ts",
    "build": "node scripts/build.ts",
    "start": "node dist/src/app/server.js",
    "test:app": "node --test --test-concurrency=1 tests/app/*.test.ts",
    "test:generation": "node --test tests/generation/*.test.ts",
    "test:agent": "node --test tests/agent/*.test.ts",
    "test:studio": "node --test tests/studio/*.test.ts"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "pg": "8.16.3",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "@types/yauzl": "2.10.3",
    "typescript": "5.9.3"
  }
}
